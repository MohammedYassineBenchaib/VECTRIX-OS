# Copy to .env and adjust. This project runs without external services.
#
# Development and CI use SQLite so the repository is self-contained.
# Production targets PostgreSQL: change the Prisma datasource provider and URL,
# then generate a baseline migration. See docs/adr/0002-postgres-production-sqlite-dev.md.
DATABASE_URL="file:./dev.db"

# Optional: public base URL used in printed QR labels (future field module).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
